# LLM provider: openai | anthropic | google | groq | ollama | openrouter | together | deepseek | mistral | vllm | lmstudio | llamacpp
# OpenAI-compatible endpoints (Ollama, OpenRouter, Together, etc.) work with LLM_BASE_URL override.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Override base URL for OpenAI-compatible endpoints (Ollama, OpenRouter, Together, etc.)
# Examples:
#   LLM_BASE_URL=http://localhost:11434/v1          (Ollama)
#   LLM_BASE_URL=https://openrouter.ai/api/v1       (OpenRouter)
#   LLM_BASE_URL=https://api.together.xyz/v1        (Together AI)
#   LLM_BASE_URL=http://localhost:1234/v1            (LM Studio)
LLM_BASE_URL=

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Embedding provider: openai | fastembed | huggingface
# fastembed is recommended for local embeddings — ONNX-based, ~50MB, zero CVEs (no torch)
# huggingface uses sentence-transformers — ~2GB+ download, requires torch (known CVEs on older versions)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# FastEmbed models (set EMBEDDING_PROVIDER=fastembed):
#   BAAI/bge-small-en-v1.5            — 384 dims, fast, good for prototyping
#   BAAI/bge-base-en-v1.5             — 768 dims, balanced speed/quality (recommended)
#   BAAI/bge-large-en-v1.5            — 1024 dims, highest quality, slower
#   sentence-transformers/all-MiniLM-L6-v2 — 384 dims, versatile, semantic search
#   sentence-transformers/all-MiniLM-L12-v2 — 384 dims, slightly better than L6
#   BAAI/bge-m3                        — 1024 dims, multilingual (100+ languages, use for Arabic/English)
#   nomic-ai/nomic-embed-text-v1.5     — 768 dims, 8192 token context, long documents
# Any FastEmbed-compatible model works — unknown models trigger a warning but still attempt to load.

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=86400

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=policies

# Retrieval
# Chunks below this score are dropped — bot replies "I don't know" instead of hallucinating
# 0.5 is balanced; raise to 0.7 for stricter grounding, lower to 0.3 if too many false negatives
RETRIEVAL_SCORE_THRESHOLD=0.3
# Retrieval strategy: mmr (default) | hybrid | hybrid_rerank
# mmr           — dense MMR for diverse, non-redundant chunks (unchanged default).
# hybrid        — dense + BM25 lexical recall fused via RRF (recovers acronyms/SKUs/exact phrases).
# hybrid_rerank — hybrid candidates passed through a reranker (integration point; default passthrough).
RETRIEVAL_STRATEGY=mmr

# Context-aware query rewriting (#1) — condense follow-ups into a standalone search query
# (using the rolling summary + recent turns) before retrieval. Skipped on the first turn.
QUERY_REWRITE_ENABLED=true

# Groundedness / faithfulness verification (#2) — verify the answer is supported by the
# retrieved chunks and expose meta.grounded. In strict mode an unsupported answer is refused.
GROUNDEDNESS_ENABLED=true
GROUNDEDNESS_MODE=heuristic        # heuristic (no extra LLM call) | llm (JSON judge)
GROUNDEDNESS_MIN_SCORE=0.5         # fraction of answer sentences that must be supported
STRICT_REFUSE_ON_UNGROUNDED=true

# Provider resilience (#14) — retry transient LLM/embedding failures + circuit breaker.
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_DELAY=0.5      # seconds; exponential backoff base
CIRCUIT_BREAKER_ENABLED=true
CB_FAILURE_THRESHOLD=5             # consecutive failures before the circuit opens
CB_RESET_SECONDS=30               # cool-down before a half-open trial call

# Persona / branding (#5) — de-hardcode the assistant identity and refusal copy.
# Defaults reproduce the original prompt strings, so leaving these unset changes nothing.
ASSISTANT_NAME=our company
KNOWLEDGE_DOMAIN=                  # e.g. "returns & shipping policy" — empty adds no framing
ESCALATION_MESSAGE=Please contact support.

# Chat mode: strict | open | learning | learning_review
# strict   — Knowledge-base-only. Refuses questions outside ingested documents. Zero hallucination risk.
# open     — Free interaction. Uses documents when available, general knowledge otherwise. Honest about provenance.
# learning — Free interaction + auto-ingest. Knowledge-gap answers are embedded into ChromaDB immediately.
#            Synthesized entries are marked with source_type=synthesized for transparency.
# learning_review — Like learning, but two-phase: synthesized answers are queued in Redis for human review
#            instead of embedded. A moderator approves (POST /api/v1/review/{entry_id}/approve → embeds) or
#            rejects (POST /api/v1/review/{entry_id}/reject → discards). Keeps unverified output out of the KB.
CHAT_MODE=strict
# Minimum answer length (chars) required for auto-ingest in the learning modes.
# Short/trivial responses ("I don't know", "ok") are never ingested.
SELF_INGEST_MIN_LENGTH=50

# Guardrails (lightweight, dependency-free; see guardrails/)
GUARDRAILS_ENABLED=true
# Reject inputs that look like prompt-injection / jailbreak attempts (returns 400).
GUARDRAILS_BLOCK_INJECTION=true
# Mask PII (emails, phone numbers, card-like digit runs) in model output.
# Off by default — a support bot often legitimately returns contact emails.
GUARDRAILS_MASK_PII=false
# Hard cap on answer length in characters; 0 disables the cap.
GUARDRAILS_MAX_ANSWER_CHARS=4000

# Ingest limits
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=120

# Durable, retryable ingestion (#4): inline (default) | queue
# inline — process in-process via FastAPI BackgroundTasks (small deployments).
# queue  — enqueue jobs onto a Redis list consumed by `python -m ingest.worker`, so
#          ingestion survives API restarts and retries transient failures. docker-compose.yml
#          runs a `worker` service and sets this to `queue`.
INGEST_MODE=inline
INGEST_MAX_ATTEMPTS=3
# Shared dir uploads are staged to in queue mode (must be a volume shared with the worker).
INGEST_INCOMING_DIR=./ingest_incoming

# App
DEBUG=false
LOG_LEVEL=INFO
# CORS — default is empty list (no cross-origin access). Add domains as needed.
# Example: CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=[]

# Security
# API key for protecting ingest endpoints. If empty, auth is skipped (local dev mode).
# DELETE /ingest/{doc_id} ALWAYS requires this key regardless of dev mode.
API_KEY=
# Set to true to require API key on POST /api/ingest and GET /api/ingest/docs
REQUIRE_AUTH_FOR_INGEST=false
# Trusted proxy IPs for rate-limiter IP extraction (e.g., ["127.0.0.1", "10.0.0.0/8"])
TRUSTED_PROXIES=[]
# Allowed hosts for document download URLs (prevents SSRF). "*" allows any public host.
ALLOWED_HOSTS=["*"]

# ─── OpenDataLoader PDF parser (optional, requires Java 11+) ───
# PDF parser override: "pypdf" | "opendataloader" | null (auto-detect)
# PDF_PARSER=
# PDF_PARSER_FALLBACK=true
# ODL_FORMAT=json,markdown
# ODL_READING_ORDER=xycut
# ODL_USE_STRUCT_TREE=false
# ODL_INCLUDE_HEADER_FOOTER=false
# ODL_HYBRID=                    # e.g. "docling-fast" — enables hybrid AI backend
# ODL_HYBRID_MODE=auto           # auto | full
# ODL_HYBRID_URL=                # e.g. http://odl-hybrid:5002
# ODL_HYBRID_FALLBACK=false
# ODL_ENRICH_FORMULA=false      # requires ODL_HYBRID_MODE=full
# ODL_ENRICH_PICTURES=false     # requires ODL_HYBRID_MODE=full

# ─── Local Deployment (Ollama + FastEmbed, zero cloud API keys) ───
# Use docker-compose.local.yml for a fully local stack:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.2
#   LLM_BASE_URL=http://ollama:11434/v1
#   EMBEDDING_PROVIDER=fastembed
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   OPENAI_API_KEY=no-key-needed
#   REDIS_HOST=redis
# See README "Fully Local Deployment" section for instructions.
