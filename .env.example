# LLM provider: openai | anthropic | google | groq | ollama | openrouter | together | deepseek | mistral | vllm | lmstudio | llamacpp
# OpenAI-compatible endpoints (Ollama, OpenRouter, Together, etc.) work with LLM_BASE_URL override.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Override base URL for OpenAI-compatible endpoints (Ollama, OpenRouter, Together, etc.)
# Examples:
#   LLM_BASE_URL=http://localhost:11434/v1          (Ollama)
#   LLM_BASE_URL=https://openrouter.ai/api/v1       (OpenRouter)
#   LLM_BASE_URL=https://api.together.xyz/v1        (Together AI)
#   LLM_BASE_URL=http://localhost:1234/v1            (LM Studio)
LLM_BASE_URL=

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Embedding provider: openai | fastembed | huggingface
# fastembed is recommended for local embeddings — ONNX-based, ~50MB, zero CVEs (no torch)
# huggingface uses sentence-transformers — ~2GB+ download, requires torch (known CVEs on older versions)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=86400

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=policies

# Retrieval
# Chunks below this score are dropped — bot replies "I don't know" instead of hallucinating
# 0.5 is balanced; raise to 0.7 for stricter grounding, lower to 0.3 if too many false negatives
RETRIEVAL_SCORE_THRESHOLD=0.3

# Ingest limits
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=120

# App
DEBUG=false
LOG_LEVEL=INFO
# CORS — default is empty list (no cross-origin access). Add domains as needed.
# Example: CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=[]

# Security
# API key for protecting ingest endpoints. If empty, auth is skipped (local dev mode).
# DELETE /ingest/{doc_id} ALWAYS requires this key regardless of dev mode.
API_KEY=
# Set to true to require API key on POST /api/ingest and GET /api/ingest/docs
REQUIRE_AUTH_FOR_INGEST=false
# Trusted proxy IPs for rate-limiter IP extraction (e.g., ["127.0.0.1", "10.0.0.0/8"])
TRUSTED_PROXIES=[]
# Allowed hosts for document download URLs (prevents SSRF). "*" allows any public host.
ALLOWED_HOSTS=["*"]
